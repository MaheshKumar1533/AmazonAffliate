# Amazon Affiliate Configuration
# Change this to your Amazon Associate Tag (e.g., yourname-20)
VITE_AMAZON_AFFILIATE_TAG=primepicks-20

# Optional API Keys for Live Data Fetching
# 1. RapidAPI Real-Time Amazon Data API key (https://rapidapi.com)
RAPIDAPI_KEY=

# 2. Rainforest API Key (https://www.rainforestapi.com)
RAINFOREST_API_KEY=

# 3. Official Amazon Product Advertising API (PA-API 5.0)
# (Available once you have 3 qualifying sales)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=primepicks-20
AMAZON_REGION=us-east-1
